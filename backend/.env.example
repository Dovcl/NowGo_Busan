# backend/.env

# 한국관광공사_국문 관광정보 서비스_GW
# 일반 인증키
TOUR_API_KEY=your_api_key_here

# 부산광역시_해수욕장 수질 정보 (BusanBeachInfoService)
# 공공데이터포털에서 해당 API 활용신청 후 발급된 키
# https://www.data.go.kr/data/15034080/openapi.do
TOUR_API_KEY_BEACH=your_beach_water_api_key_here

# 국립해양조사원_이안류 지수 조회 (ripCurrent)
# https://www.data.go.kr/data/15156028/openapi.do
# Endpoint: /1192136/ripCurrent/GetRipCurrentApiService
TOUR_API_KEY_IAN=your_rip_current_api_key_here

# 카카오 로컬 API (REST) — 부산 관광지 데이터 커버리지 검증용
# https://developers.kakao.com > 내 애플리케이션 > REST API 키 (JS 키와 다름)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 기상청_단기예보 조회서비스 / 생활기상지수 조회서비스(4.0) 공용
# data.go.kr는 기관별로 계정 서비스키 하나를 여러 API에 재사용함
# https://www.data.go.kr/data/15084084/openapi.do (단기예보)
# https://www.data.go.kr/data/15085288/openapi.do (생활기상지수)
WEATHER_API_KEY=your_kma_service_key_here

# 한국환경공단_에어코리아_대기오염정보 (개발계정 트래픽 500회/일 — api-quota-check.md 참고)
# https://www.data.go.kr/tcs/dss/selectApiDataDetailView.do?publicDataPk=15073861
AIR_KOREA_API_KEY=your_airkorea_api_key_here

# 로컬 PostGIS (docker-compose.yml이 그대로 참조함)
DATABASE_NAME=nowgo_busan
DATABASE_USER=nowgo
DATABASE_PASSWORD=change_me_local_only
DATABASE_HOST=localhost
DATABASE_PORT=5434

